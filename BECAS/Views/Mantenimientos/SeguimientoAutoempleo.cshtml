<div class="card">
    <div class="card-header">
        <h3 class="card-title">Emprendimiento</h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="example1" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>PId</th>
                    <th>Nombre</th>
                    <th>Sexo</th>
                    <th>Empresa</th>
                    <th>Tipo Capital</th>
                    <th>Estado</th>
                    <th>Tipo Financiamiento</th>
                    <th>Tipo Empresa</th>
                    <th>Tipo EmpresaOtro</th>
                    <th>Plan de Negocios</th>
                    <th>Registro</th>
                    <th>Fecha Inicio</th>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var item in Model.AutoempleoTables)
                    {
                        <tr>
                            <td>@item.PId</td>
                            <td>
                                @if (item.persona != null)
                                {
                                    @item.persona.Nombre
                                }
                            </td>
                            <td>
                                @if (item.persona != null)
                                {
                                    @if (@item.persona.sexo != null)
                                    {
                                        @item.persona.sexo.Nombre
                                    }
                                }
                            </td>
                            <td>@item.AutoempEmpresa</td>
                            <td>@item.AutoempTipoCapital</td>
                            <td>@item.AutoempEstado</td>
                            <td>@item.AutoempTipoFinanciamiento</td>
                            <td>@item.AutoempTipoEmpresa</td>
                            <td>@item.AutoempTipoEmpresaOtro</td>
                            <td>@item.AutoempPlanNegocios</td>
                            <td>@item.AutoempRegistro</td>
                            <td>@item.AutoempFechaInicio</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <!-- /.card-body -->
</div>

@section scripts{
